{
  "name": "interview-exercise",
  "version": "1.0.0",
  "description": "JavaScript TanStack Start app with a local Firestore emulator",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-start.js",
    "dev": "firebase emulators:exec --only firestore --project demo-interview-exercise --ui --import=.firebase/data --export-on-exit=.firebase/data \"npm run dev:app\"",
    "dev:app": "vite dev",
    "emulator": "firebase emulators:start --only firestore --project demo-interview-exercise --import=.firebase/data --export-on-exit=.firebase/data",
    "build": "vite build",
    "seed": "node scripts/seed.js",
    "test": "firebase emulators:exec --only firestore --project demo-interview-exercise \"node --test tests/firestore.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "firebase-admin": "^14.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "firebase-tools": "^15.31.0",
    "vite": "^8.3.1"
  }
}
